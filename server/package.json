{
  "name": "immofacile-server",
  "version": "1.0.0",
  "description": "ImmoFacile - Backend server for rent receipt management system",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "cd ../client && npm run build",
    "start:prod": "NODE_ENV=production node index.js",
    "build:prod": "npm run build && npm run start:prod",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint ."
  },
  "keywords": [
    "immofacile",
    "immobilier",
    "rent",
    "receipts",
    "property",
    "management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.19.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^16.3.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
